@model Product

<h1>@Model.Name</h1>

<div class="row">
    <div class="col-md-6">
        @if (Model.Images.Any())
        {
            @foreach (var image in Model.Images.Select((url, index) => (url, index)))
            {
                <img src="@image.url.Url" class="img-fluid mb-3" alt="@Model.Name" style="height: 400px; object-fit: cover;">
            }
        }
        else
        {
            <img src="/images/no-image.png" class="img-fluid" alt="No image" style="height: 400px; object-fit: cover;">
        }
    </div>
    <div class="col-md-6">
        <h3 class="text-primary">@Model.Price.ToString("C")</h3>
        <p><strong>Category:</strong> @Model.Category?.Name</p>
        <p><strong>Description:</strong></p>
        <p>@Model.Description</p>
        <p class="text-muted">Added on @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
        <a asp-action="Index" class="btn btn-secondary">Back to Shop</a>
    </div>
</div>
