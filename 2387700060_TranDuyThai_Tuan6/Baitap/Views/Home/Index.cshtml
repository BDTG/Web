@model IEnumerable<Product>

<h1>Welcome to Our Shop</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <h5>Categories</h5>
        <div class="list-group">
            <a asp-action="Index" asp-route-categoryId=""
               class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == null ? "active" : "")">
                All Products
            </a>
            @foreach (var cat in ViewBag.Categories as IEnumerable<Category>)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.Id"
                   class="list-group-item list-group-item-action @(ViewBag.SelectedCategoryId == cat.Id ? "active" : "")">
                    @cat.Name
                </a>
            }
        </div>
    </div>
    <div class="col-md-9">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100">
                        <img src="@(product.Images.FirstOrDefault(i => i.IsPrimary)?.Url ?? "/images/no-image.png")"
                             class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body">
                            <h5 class="card-title">@product.Name</h5>
                            <p class="card-text text-muted">@product.Category?.Name</p>
                            <p class="card-text fw-bold text-primary">@product.Price.ToString("C")</p>
                            <p class="card-text">@(product.Description?.Length > 100 ? product.Description[..100] + "..." : product.Description)</p>
                            <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary">View Details</a>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">No products found.</div>
        }
    </div>
</div>
